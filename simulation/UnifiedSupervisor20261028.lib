* UnifiedSupervisor20261028.lib
* Reconstructed behavioural library for Unified_Supervisor.asc (REV F)
* Analog command-current supervisor - LTspice (also parses in ngspice 42)
* All models are functional approximations, not vendor models.
*
* Node orders match the PIN SpiceOrder in the companion .asy symbols.

*==================== Time-controlled test switches ====================
* SPST  (pins A B)      : MODE=0 S0 master (always closed)
*                         MODE=1 S1 coil link (closed, open 1.5-2.2 s)
*                         MODE=3 S3 high-test (open, closed 3.9-4.3 s)
* SPDT  (pins A B COM)  : COM-A by default, COM-B while active
*                         MODE=2 S2 sense select (TEST 3.5-4.3 s)
*                         MODE=4 S4 command (ON/+5V 0.5-2.5 s, 3.0-4.6 s)
*                         MODE=5 S5 stuck driver (STUCK/+5V 5.0-5.8 s)
* Transitions take 10 us. SPDT is break-before-make.
.model SW_USUP_ON  SW(Ron=10m Roff=1G Vt=0.5 Vh=0)
.model SW_USUP_BBM SW(Ron=10m Roff=1G Vt=0.7 Vh=0)

.subckt SPST A B MODE=0
VCTL ctl 0 PWL(0 {max(0,1-abs(MODE-0))+max(0,1-abs(MODE-1))} 1.5 {max(0,1-abs(MODE-0))+max(0,1-abs(MODE-1))} 1.50001 {max(0,1-abs(MODE-0))} 2.2 {max(0,1-abs(MODE-0))} 2.20001 {max(0,1-abs(MODE-0))+max(0,1-abs(MODE-1))} 3.9 {max(0,1-abs(MODE-0))+max(0,1-abs(MODE-1))} 3.90001 {max(0,1-abs(MODE-0))+max(0,1-abs(MODE-1))+max(0,1-abs(MODE-3))} 4.3 {max(0,1-abs(MODE-0))+max(0,1-abs(MODE-1))+max(0,1-abs(MODE-3))} 4.30001 {max(0,1-abs(MODE-0))+max(0,1-abs(MODE-1))})
S1 A B ctl 0 SW_USUP_ON
.ends SPST

.subckt SPDT A B COM MODE=2
VCTB ctb 0 PWL(0 {0} 0.5 {0} 0.50001 {max(0,1-abs(MODE-4))} 2.5 {max(0,1-abs(MODE-4))} 2.50001 {0} 3 {0} 3.00001 {max(0,1-abs(MODE-4))} 3.5 {max(0,1-abs(MODE-4))} 3.50001 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))} 4.3 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))} 4.30001 {max(0,1-abs(MODE-4))} 4.6 {max(0,1-abs(MODE-4))} 4.60001 {0} 5 {0} 5.00001 {max(0,1-abs(MODE-5))} 5.8 {max(0,1-abs(MODE-5))} 5.80001 {0})
VCTA cta 0 PWL(0 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))+max(0,1-abs(MODE-5))} 0.5 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))+max(0,1-abs(MODE-5))} 0.50001 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-5))} 2.5 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-5))} 2.50001 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))+max(0,1-abs(MODE-5))} 3 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))+max(0,1-abs(MODE-5))} 3.00001 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-5))} 3.5 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-5))} 3.50001 {max(0,1-abs(MODE-5))} 4.3 {max(0,1-abs(MODE-5))} 4.30001 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-5))} 4.6 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-5))} 4.60001 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))+max(0,1-abs(MODE-5))} 5 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))+max(0,1-abs(MODE-5))} 5.00001 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))} 5.8 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))} 5.80001 {max(0,1-abs(MODE-2))+max(0,1-abs(MODE-4))+max(0,1-abs(MODE-5))})
SA COM A cta 0 SW_USUP_BBM
SB COM B ctb 0 SW_USUP_BBM
.ends SPDT

*==================== 7805 linear regulator ====================
* 5.000 V, 10 mohm output resistance, 2 V dropout, 5 mA quiescent.
* Load current is drawn from IN so the 12 V rail sees it.
.subckt REG7805 IN GND OUT
B1 n1 GND V=max(0,min(5,V(IN,GND)-2))
R1 n1 n2 10m
VSNS n2 OUT 0
BIN IN GND I=I(VSNS)
BQ IN GND I=5m*min(1,max(0,V(IN,GND)/7))
.ends REG7805

*==================== LM358 dual op-amp (12 V / GND) ====================
* Aol 100 dB, GBW 1 MHz, slew 0.3 V/us, Vos +2.195 mV, output 0 .. V+ -1.5 V, Rout 10 ohm.
.subckt LM358_HALF P M VCC VEE OUT
B1 VEE n2 I=max(-4.8m,min(4.8m,0.1*(V(P,M)+2.195m)))
R1 n2 VEE 1Meg
C1 n2 VEE 15.9n
BCL n2 VEE I=max(0,V(n2,VEE)-V(VCC,VEE)+1.5)+min(0,V(n2,VEE))
B2 n3 VEE V=V(n2,VEE)
R2 n3 OUT 10
.ends LM358_HALF

.subckt LM358_DUAL OUTA INA- INA+ GND INB+ INB- OUTB V+
XA INA+ INA- V+ GND OUTA LM358_HALF
XB INB+ INB- V+ GND OUTB LM358_HALF
RQ V+ GND 24k
.ends LM358_DUAL

*==================== LM339 quad comparator (12 V / GND) ====================
* Open-collector output: OFF (pulled up externally) when IN+ > IN-.
* Saturated output modelled as 66 ohm to GND, ~0.3 us response.
.subckt LM339_CMP P M GND OUT
B1 s GND V=0.5+0.5*tanh(V(P,M)/0.5m)
R1 s s2 1k
C1 s2 GND 0.3n
B2 OUT GND I=(1-V(s2,GND))*V(OUT,GND)/66
R2 OUT GND 1G
.ends LM339_CMP

.subckt LM339_QUAD OUT1 OUT2 V+ IN2- IN2+ IN1- IN1+ IN3- IN3+ IN4- IN4+ GND OUT4 OUT3
X1 IN1+ IN1- GND OUT1 LM339_CMP
X2 IN2+ IN2- GND OUT2 LM339_CMP
X3 IN3+ IN3- GND OUT3 LM339_CMP
X4 IN4+ IN4- GND OUT4 LM339_CMP
RQ V+ GND 15k
.ends LM339_QUAD

*==================== 74HC logic, 5 V functional ====================
* Threshold VCC/2, output 25 ohm, 14-pin DIP node order.
.subckt HC_AND2 A B Y VCC GND
B1 n1 GND V=V(VCC,GND)*(0.5+0.5*tanh((V(A,GND)-0.5*V(VCC,GND))/0.05))*(0.5+0.5*tanh((V(B,GND)-0.5*V(VCC,GND))/0.05))
R1 n1 Y 25
C1 Y GND 5p
.ends HC_AND2

.subckt HC_OR2 A B Y VCC GND
B1 n1 GND V=V(VCC,GND)*(1-(1-(0.5+0.5*tanh((V(A,GND)-0.5*V(VCC,GND))/0.05)))*(1-(0.5+0.5*tanh((V(B,GND)-0.5*V(VCC,GND))/0.05))))
R1 n1 Y 25
C1 Y GND 5p
.ends HC_OR2

.subckt HC_INV A Y VCC GND
B1 n1 GND V=V(VCC,GND)*(1-(0.5+0.5*tanh((V(A,GND)-0.5*V(VCC,GND))/0.05)))
R1 n1 Y 25
C1 Y GND 5p
.ends HC_INV

.subckt HC08 1A 1B 1Y 2A 2B 2Y GND 3Y 3A 3B 4Y 4A 4B VCC
X1 1A 1B 1Y VCC GND HC_AND2
X2 2A 2B 2Y VCC GND HC_AND2
X3 3A 3B 3Y VCC GND HC_AND2
X4 4A 4B 4Y VCC GND HC_AND2
RQ VCC GND 1Meg
.ends HC08

.subckt HC32 1A 1B 1Y 2A 2B 2Y GND 3Y 3A 3B 4Y 4A 4B VCC
X1 1A 1B 1Y VCC GND HC_OR2
X2 2A 2B 2Y VCC GND HC_OR2
X3 3A 3B 3Y VCC GND HC_OR2
X4 4A 4B 4Y VCC GND HC_OR2
RQ VCC GND 1Meg
.ends HC32

.subckt HC04 1A 1Y 2A 2Y 3A 3Y GND 4Y 4A 5Y 5A 6Y 6A VCC
X1 1A 1Y VCC GND HC_INV
X2 2A 2Y VCC GND HC_INV
X3 3A 3Y VCC GND HC_INV
X4 4A 4Y VCC GND HC_INV
X5 5A 5Y VCC GND HC_INV
X6 6A 6Y VCC GND HC_INV
RQ VCC GND 1Meg
.ends HC04

*==================== IRLZ44N logic-level MOSFET (approx.) ====================
* Level-1 core, Vto 1.8 V, ~38 mohm at Vgs = 5 V, with body diode and caps.
.model NM_IRLZ44N_CORE NMOS(Level=1 Vto=1.8 Kp=8.3 Lambda=0)
.model DB_IRLZ44N D(Is=1p N=1 Rs=10m BV=55 Cjo=500p)
.subckt IRLZ44N_APPROX D G S
M1 D G S S NM_IRLZ44N_CORE L=1u W=1u
DB S D DB_IRLZ44N
CGS G S 1.5n
CGD G D 150p
.ends IRLZ44N_APPROX

*==================== Discrete semiconductors ====================
.model D5408_APPROX D(Is=63n Rs=14m N=1.7 BV=1000 Ibv=10u Cjo=53p Tt=4.3u)
.model D4148 D(Is=2.52n Rs=0.568 N=1.752 BV=100 Ibv=100u Cjo=4p M=0.4 Tt=20n)
.model LED_GREEN  D(Is=1e-19 N=2.0 Rs=5 Cjo=30p)
.model LED_YELLOW D(Is=1e-19 N=1.95 Rs=5 Cjo=30p)
.model LED_RED    D(Is=1e-18 N=1.8 Rs=5 Cjo=30p)
.model Q3904 NPN(Is=6.734f Xti=3 Eg=1.11 Vaf=74.03 Bf=416.4 Ne=1.259 Ise=6.734f Ikf=66.78m Xtb=1.5 Br=.7371 Nc=2 Isc=0 Ikr=0 Rc=1 Cjc=3.638p Mjc=.3085 Vjc=.75 Fc=.5 Cje=4.493p Mje=.2593 Vje=.75 Tr=239.5n Tf=301.2p Itf=.4 Vtf=4 Xtf=2 Rb=10)

*==================== Passive helpers ====================
* 10 k potentiometer: K = fraction of track between W and BOT.
.subckt POT10K TOP W BOT K=0.5
R1 TOP W {max(1m,10k*(1-K))}
R2 W BOT {max(1m,10k*K)}
.ends POT10K

* 5 V active buzzer: ~25 mA resistive load.
.subckt BUZZER5 P N
R1 P N 200
C1 P N 1n
.ends BUZZER5
